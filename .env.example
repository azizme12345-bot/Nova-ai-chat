# GOOGLE_API_KEY: Required for backend Gemini AI API calls.
# Configure this in your .env file or deployment environment variables.
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"

# GEMINI_API_KEY: Automatically injected by AI Studio at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
